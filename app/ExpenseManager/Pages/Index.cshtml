@page
@model ExpenseManager.Pages.IndexModel
@{
    ViewData["Title"] = "Expense Manager Dashboard";
}

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="error-banner">
        <div class="error-banner-content">
            <span class="error-icon">⚠️</span>
            <span class="error-text"><strong>Database Connection Issue:</strong> @Model.ErrorMessage</span>
            <span class="error-note">(Showing sample data below)</span>
        </div>
    </div>
}

<div class="page-header">
    <h1>Expense Management</h1>
    <p class="subtitle">Track, submit, and manage your business expenses</p>
</div>

<!-- Dashboard Summary Cards -->
<div class="stats-grid">
    <div class="stat-card stat-total">
        <div class="stat-icon">📋</div>
        <div class="stat-value">@Model.Summary?.TotalExpenses</div>
        <div class="stat-label">Total Expenses</div>
    </div>
    <div class="stat-card stat-pending">
        <div class="stat-icon">⏳</div>
        <div class="stat-value">@Model.Summary?.PendingExpenses</div>
        <div class="stat-label">Pending Approval</div>
    </div>
    <div class="stat-card stat-approved">
        <div class="stat-icon">✅</div>
        <div class="stat-value">@Model.Summary?.ApprovedExpenses</div>
        <div class="stat-label">Approved</div>
    </div>
    <div class="stat-card stat-amount">
        <div class="stat-icon">£</div>
        <div class="stat-value">£@(Model.Summary?.TotalAmountGBP.ToString("N2"))</div>
        <div class="stat-label">Total Amount</div>
    </div>
</div>

<!-- Action Bar -->
<div class="action-bar">
    <div class="action-bar-left">
        <a href="/Expenses/Create" class="btn btn-primary">
            <span>＋</span> New Expense
        </a>
        <a href="/Expenses" class="btn btn-secondary">View All Expenses</a>
        <a href="/swagger" class="btn btn-outline" target="_blank">📚 API Docs</a>
        <a href="/chatui" class="btn btn-chat">💬 AI Assistant</a>
    </div>
    <div class="action-bar-right">
        <form method="get" class="filter-form">
            <select name="statusFilter" class="filter-select" onchange="this.form.submit()">
                <option value="">All Statuses</option>
                @foreach (var status in Model.Statuses)
                {
                    if (Model.StatusFilter == status.StatusId)
                    {
                        <option value="@status.StatusId" selected>@status.StatusName</option>
                    }
                    else
                    {
                        <option value="@status.StatusId">@status.StatusName</option>
                    }
                }
            </select>
            <select name="categoryFilter" class="filter-select" onchange="this.form.submit()">
                <option value="">All Categories</option>
                @foreach (var cat in Model.Categories)
                {
                    if (Model.CategoryFilter == cat.CategoryId)
                    {
                        <option value="@cat.CategoryId" selected>@cat.CategoryName</option>
                    }
                    else
                    {
                        <option value="@cat.CategoryId">@cat.CategoryName</option>
                    }
                }
            </select>
        </form>
    </div>
</div>

<!-- Expenses Table -->
<div class="table-container">
    <table class="expense-table">
        <thead>
            <tr>
                <th>#</th>
                <th>Employee</th>
                <th>Category</th>
                <th>Date</th>
                <th>Description</th>
                <th>Amount</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Expenses.Count == 0)
            {
                <tr>
                    <td colspan="8" class="empty-state">
                        <p>No expenses found. <a href="/Expenses/Create">Submit your first expense</a>.</p>
                    </td>
                </tr>
            }
            @foreach (var expense in Model.Expenses)
            {
                <tr class="expense-row status-@expense.StatusName.ToLower()">
                    <td>@expense.ExpenseId</td>
                    <td>@expense.UserName</td>
                    <td><span class="category-badge">@expense.CategoryName</span></td>
                    <td>@expense.ExpenseDate.ToString("dd MMM yyyy")</td>
                    <td class="description-cell">@expense.Description</td>
                    <td class="amount-cell">£@expense.AmountGBP.ToString("N2")</td>
                    <td><span class="status-badge status-@expense.StatusName.ToLower()">@expense.StatusName</span></td>
                    <td class="action-cell">
                        <a href="/Expenses/Details?id=@expense.ExpenseId" class="btn-icon" title="View">👁</a>
                        <a href="/Expenses/Edit?id=@expense.ExpenseId" class="btn-icon" title="Edit">✏️</a>
                        @if (expense.StatusName == "Submitted")
                        {
                            <a href="/Expenses/Approve?id=@expense.ExpenseId" class="btn-icon btn-approve" title="Approve">✅</a>
                            <a href="/Expenses/Reject?id=@expense.ExpenseId" class="btn-icon btn-reject" title="Reject">❌</a>
                        }
                        <button onclick="deleteExpense(@expense.ExpenseId)" class="btn-icon btn-delete" title="Delete">🗑️</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <script>
        async function deleteExpense(id) {
            if (!confirm('Are you sure you want to delete this expense?')) return;
            try {
                const response = await fetch(`/api/expenses/${id}`, { method: 'DELETE' });
                const data = await response.json();
                if (data.success) {
                    location.reload();
                } else {
                    alert('Error deleting expense: ' + (data.error || 'Unknown error'));
                }
            } catch (e) {
                alert('Error: ' + e.message);
            }
        }
    </script>
}
