@page "/chatui"
@model ExpenseManager.Pages.Chat.ChatUIModel
@{
    ViewData["Title"] = "AI Assistant";
    Layout = "_Layout";
}

<style>
.chat-container {
    max-width: 900px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    height: calc(100vh - 200px);
    min-height: 500px;
}

.chat-header {
    background: linear-gradient(135deg, #6366f1, #8b5cf6);
    color: white;
    border-radius: 0.75rem 0.75rem 0 0;
    padding: 1.25rem 1.5rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
}

.chat-header-icon { font-size: 1.5rem; }

.chat-header-text h2 {
    font-size: 1.125rem;
    font-weight: 600;
    margin: 0;
}

.chat-header-text p {
    font-size: 0.8125rem;
    opacity: 0.8;
    margin: 0;
}

.chat-status-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #10b981;
    margin-left: auto;
    box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.3);
}

.chat-status-dot.offline { background: #f59e0b; }

.chat-messages {
    flex: 1;
    overflow-y: auto;
    padding: 1.5rem;
    background: #f8fafc;
    display: flex;
    flex-direction: column;
    gap: 1rem;
}

.message {
    display: flex;
    gap: 0.75rem;
    max-width: 80%;
    animation: fadeIn 0.2s ease-out;
}

@@keyframes fadeIn {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
}

.message-user { align-self: flex-end; flex-direction: row-reverse; }

.message-avatar {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1rem;
    flex-shrink: 0;
}

.message-user .message-avatar { background: #6366f1; color: white; }
.message-assistant .message-avatar { background: #e0e7ff; }

.message-bubble {
    padding: 0.75rem 1rem;
    border-radius: 0.75rem;
    font-size: 0.9375rem;
    line-height: 1.6;
    max-width: 100%;
    overflow-wrap: break-word;
}

.message-user .message-bubble {
    background: #6366f1;
    color: white;
    border-bottom-right-radius: 0.25rem;
}

.message-assistant .message-bubble {
    background: white;
    color: #1f2937;
    border: 1px solid #e5e7eb;
    border-bottom-left-radius: 0.25rem;
    box-shadow: 0 1px 2px rgba(0,0,0,0.05);
}

.message-bubble ul { padding-left: 1.5rem; margin: 0.5rem 0; }
.message-bubble ol { padding-left: 1.5rem; margin: 0.5rem 0; }
.message-bubble li { margin: 0.25rem 0; }
.message-bubble strong { font-weight: 600; }
.message-bubble br { display: block; margin-bottom: 0.25rem; }

.typing-indicator {
    display: flex;
    gap: 4px;
    padding: 0.75rem 1rem;
    align-items: center;
}

.typing-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #9ca3af;
    animation: bounce 1.4s infinite ease-in-out;
}

.typing-dot:nth-child(1) { animation-delay: -0.32s; }
.typing-dot:nth-child(2) { animation-delay: -0.16s; }

@@keyframes bounce {
    0%, 80%, 100% { transform: scale(0.8); }
    40% { transform: scale(1.2); }
}

.chat-input-area {
    background: white;
    border-top: 1px solid #e5e7eb;
    padding: 1rem 1.5rem;
    border-radius: 0 0 0.75rem 0.75rem;
    box-shadow: 0 -4px 6px -1px rgba(0,0,0,0.05);
}

.chat-input-row {
    display: flex;
    gap: 0.75rem;
    align-items: flex-end;
}

.chat-input {
    flex: 1;
    padding: 0.75rem 1rem;
    border: 1px solid #d1d5db;
    border-radius: 0.5rem;
    font-size: 0.9375rem;
    resize: none;
    min-height: 44px;
    max-height: 120px;
    font-family: inherit;
    transition: border-color 0.15s;
}

.chat-input:focus {
    outline: none;
    border-color: #6366f1;
    box-shadow: 0 0 0 3px rgba(99,102,241,0.15);
}

.chat-send-btn {
    width: 44px;
    height: 44px;
    border-radius: 0.5rem;
    background: #6366f1;
    color: white;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.125rem;
    transition: background 0.15s;
    flex-shrink: 0;
}

.chat-send-btn:hover { background: #4f46e5; }
.chat-send-btn:disabled { background: #9ca3af; cursor: not-allowed; }

.chat-suggestions {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-top: 0.75rem;
}

.chat-suggestion {
    padding: 0.375rem 0.75rem;
    background: #f0f0ff;
    color: #6366f1;
    border: 1px solid #c7d2fe;
    border-radius: 9999px;
    font-size: 0.8125rem;
    cursor: pointer;
    transition: all 0.15s;
    font-family: inherit;
}

.chat-suggestion:hover { background: #e0e7ff; }
</style>

<div class="chat-container">
    <div class="chat-header">
        <div class="chat-header-icon">🤖</div>
        <div class="chat-header-text">
            <h2>Expense AI Assistant</h2>
            <p>Powered by GPT-4o • Ask me anything about your expenses</p>
        </div>
        <div class="chat-status-dot @(!Model.IsConfigured ? "offline" : "")"></div>
    </div>

    <div class="chat-messages" id="chatMessages">
        <div class="message message-assistant">
            <div class="message-avatar">🤖</div>
            <div class="message-bubble" id="welcomeMsg">
                @if (Model.IsConfigured)
                {
                    <span>👋 Hello! I'm your Expense Management AI Assistant. I can help you:</span>
                    <ul>
                        <li>View and filter expenses</li>
                        <li>Create new expense claims</li>
                        <li>Approve or reject submitted expenses</li>
                        <li>Get expense summaries and reports</li>
                    </ul>
                    <span>What would you like to do?</span>
                }
                else
                {
                    <strong>⚠️ GenAI Services Not Deployed</strong>
                    <br /><br />
                    <span>To enable the AI assistant, run:</span>
                    <br />
                    <code style="background:#f3f4f6;padding:0.25rem 0.5rem;border-radius:4px;font-family:monospace">./deploy-with-chat.sh</code>
                    <br /><br />
                    <span>This will deploy Azure OpenAI and AI Search services and configure the endpoint automatically.</span>
                }
            </div>
        </div>
    </div>

    <div class="chat-input-area">
        <div class="chat-input-row">
            <textarea id="chatInput" class="chat-input" placeholder="Ask about your expenses..." rows="1" @(!Model.IsConfigured ? "disabled" : "")></textarea>
            <button id="sendBtn" class="chat-send-btn" @(!Model.IsConfigured ? "disabled" : "") title="Send">➤</button>
        </div>
        @if (Model.IsConfigured)
        {
            <div class="chat-suggestions">
                <button class="chat-suggestion" onclick="sendSuggestion('Show me all pending expenses')">📋 Pending expenses</button>
                <button class="chat-suggestion" onclick="sendSuggestion('What is the total amount of all approved expenses?')">💰 Total approved</button>
                <button class="chat-suggestion" onclick="sendSuggestion('List all users in the system')">👥 All users</button>
                <button class="chat-suggestion" onclick="sendSuggestion('Show me the dashboard summary')">📊 Dashboard summary</button>
                <button class="chat-suggestion" onclick="sendSuggestion('List all expense categories')">🏷️ Categories</button>
            </div>
        }
    </div>
</div>

@section Scripts {
<script>
    const chatMessages = document.getElementById('chatMessages');
    const chatInput = document.getElementById('chatInput');
    const sendBtn = document.getElementById('sendBtn');
    let conversationHistory = [];

    // Auto-resize textarea
    chatInput.addEventListener('input', function() {
        this.style.height = 'auto';
        this.style.height = Math.min(this.scrollHeight, 120) + 'px';
    });

    // Send on Enter (Shift+Enter for new line)
    chatInput.addEventListener('keydown', function(e) {
        if (e.key === 'Enter' && !e.shiftKey) {
            e.preventDefault();
            sendMessage();
        }
    });

    sendBtn.addEventListener('click', sendMessage);

    function sendSuggestion(text) {
        chatInput.value = text;
        sendMessage();
    }

    function escapeHtml(text) {
        const div = document.createElement('div');
        div.appendChild(document.createTextNode(text));
        return div.innerHTML;
    }

    function formatMessage(text) {
        // Escape HTML first to prevent XSS
        let escaped = escapeHtml(text);

        // Apply markdown-style formatting after escaping
        // Bold: **text** -> <strong>text</strong>
        escaped = escaped.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>');

        // Code blocks: `text` -> <code>text</code>
        escaped = escaped.replace(/`([^`]+)`/g, '<code style="background:#f3f4f6;padding:0.125rem 0.375rem;border-radius:3px;font-family:monospace;font-size:0.875em">$1</code>');

        // Split into lines and handle lists
        const lines = escaped.split('\n');
        const result = [];
        let inUl = false, inOl = false;

        for (let i = 0; i < lines.length; i++) {
            const line = lines[i].trim();

            // Numbered list: lines starting with "1. " "2. " etc.
            if (/^\d+\.\s/.test(line)) {
                if (!inOl) {
                    if (inUl) { result.push('</ul>'); inUl = false; }
                    result.push('<ol>');
                    inOl = true;
                }
                result.push('<li>' + line.replace(/^\d+\.\s/, '') + '</li>');
                continue;
            }

            // Bullet list: lines starting with "- " or "* "
            if (/^[-*]\s/.test(line)) {
                if (!inUl) {
                    if (inOl) { result.push('</ol>'); inOl = false; }
                    result.push('<ul>');
                    inUl = true;
                }
                result.push('<li>' + line.replace(/^[-*]\s/, '') + '</li>');
                continue;
            }

            // Close lists
            if (inOl) { result.push('</ol>'); inOl = false; }
            if (inUl) { result.push('</ul>'); inUl = false; }

            if (line === '') {
                result.push('<br>');
            } else {
                result.push(line + '<br>');
            }
        }

        if (inOl) result.push('</ol>');
        if (inUl) result.push('</ul>');

        return result.join('');
    }

    function addMessage(role, content, isLoading = false) {
        const msgDiv = document.createElement('div');
        msgDiv.className = `message message-${role}`;

        const avatar = document.createElement('div');
        avatar.className = 'message-avatar';
        avatar.textContent = role === 'user' ? '👤' : '🤖';

        const bubble = document.createElement('div');
        bubble.className = 'message-bubble';

        if (isLoading) {
            bubble.innerHTML = '<div class="typing-indicator"><div class="typing-dot"></div><div class="typing-dot"></div><div class="typing-dot"></div></div>';
            msgDiv.id = 'loadingMsg';
        } else {
            // Use innerHTML with formatted content (HTML-safe)
            bubble.innerHTML = formatMessage(content);
        }

        msgDiv.appendChild(avatar);
        msgDiv.appendChild(bubble);
        chatMessages.appendChild(msgDiv);
        chatMessages.scrollTop = chatMessages.scrollHeight;
        return msgDiv;
    }

    async function sendMessage() {
        const message = chatInput.value.trim();
        if (!message) return;

        chatInput.value = '';
        chatInput.style.height = 'auto';
        sendBtn.disabled = true;

        addMessage('user', message);
        conversationHistory.push({ role: 'user', content: message });

        const loadingMsg = addMessage('assistant', '', true);

        try {
            const response = await fetch('/api/chat', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    message: message,
                    history: conversationHistory.slice(-10)
                })
            });

            const data = await response.json();
            loadingMsg.remove();

            const reply = data.reply || data.error || 'Sorry, I could not process your request.';
            addMessage('assistant', reply);
            conversationHistory.push({ role: 'assistant', content: reply });
        } catch (error) {
            loadingMsg.remove();
            addMessage('assistant', 'Sorry, there was an error connecting to the AI service. Please try again.');
        } finally {
            sendBtn.disabled = false;
            chatInput.focus();
        }
    }
</script>
}
