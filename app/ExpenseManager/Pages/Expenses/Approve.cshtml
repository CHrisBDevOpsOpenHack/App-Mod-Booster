@page
@model ExpenseManager.Pages.Expenses.ApproveModel
@{
    ViewData["Title"] = "Approve Expense";
}

<div class="page-header">
    <h1>Approve Expense #@Model.Expense?.ExpenseId</h1>
</div>

<div class="form-container">
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-error">@Model.ErrorMessage</div>
    }

    <div class="detail-card">
        <p><strong>Employee:</strong> @Model.Expense?.UserName</p>
        <p><strong>Amount:</strong> £@Model.Expense?.AmountGBP.ToString("N2")</p>
        <p><strong>Description:</strong> @Model.Expense?.Description</p>
    </div>

    <form method="post" asp-route-id="@Model.Expense?.ExpenseId">
        @Html.AntiForgeryToken()
        <div class="form-group">
            <label>Reviewing Manager (ID)</label>
            <input type="number" name="reviewerId" class="form-control" required value="2" />
        </div>
        <div class="form-actions">
            <button type="submit" class="btn btn-approve">✅ Confirm Approve</button>
            <a href="/Index" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>
