@page
@model ExpenseManager.Pages.Expenses.EditModel
@{
    ViewData["Title"] = "Edit Expense";
}

<div class="page-header">
    <h1>Edit Expense #@Model.Expense?.ExpenseId</h1>
    <p class="subtitle">Update the details of this expense</p>
</div>

<div class="form-container">
    <form method="post" class="expense-form">
        @Html.AntiForgeryToken()
        <input type="hidden" name="ExpenseId" value="@Model.Expense?.ExpenseId" />

        <div class="form-row">
            <div class="form-group">
                <label for="CategoryId">Category</label>
                <select id="CategoryId" name="CategoryId" class="form-control" required>
                    @foreach (var cat in Model.Categories)
                    {
                        if (Model.Expense?.CategoryId == cat.CategoryId)
                        {
                            <option value="@cat.CategoryId" selected>@cat.CategoryName</option>
                        }
                        else
                        {
                            <option value="@cat.CategoryId">@cat.CategoryName</option>
                        }
                    }
                </select>
            </div>
            <div class="form-group">
                <label for="StatusId">Status</label>
                <select id="StatusId" name="StatusId" class="form-control">
                    @foreach (var status in Model.Statuses)
                    {
                        if (Model.Expense?.StatusId == status.StatusId)
                        {
                            <option value="@status.StatusId" selected>@status.StatusName</option>
                        }
                        else
                        {
                            <option value="@status.StatusId">@status.StatusName</option>
                        }
                    }
                </select>
            </div>
        </div>

        <div class="form-row">
            <div class="form-group">
                <label for="AmountGBP">Amount (£)</label>
                <div class="input-group">
                    <span class="input-prefix">£</span>
                    <input type="number" id="AmountGBP" name="AmountGBP" class="form-control" step="0.01" min="0.01" required value="@Model.Expense?.AmountGBP.ToString("F2")" />
                </div>
            </div>
            <div class="form-group">
                <label for="ExpenseDate">Expense Date</label>
                <input type="date" id="ExpenseDate" name="ExpenseDate" class="form-control" required value="@Model.Expense?.ExpenseDate.ToString("yyyy-MM-dd")" />
            </div>
        </div>

        <div class="form-group">
            <label for="Description">Description</label>
            <textarea id="Description" name="Description" class="form-control" rows="3">@Model.Expense?.Description</textarea>
        </div>

        <div class="form-group">
            <label for="ReceiptFile">Receipt Reference</label>
            <input type="text" id="ReceiptFile" name="ReceiptFile" class="form-control" value="@Model.Expense?.ReceiptFile" />
        </div>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-error">@Model.ErrorMessage</div>
        }

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Save Changes</button>
            <a href="/Expenses/Details?id=@Model.Expense?.ExpenseId" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>
